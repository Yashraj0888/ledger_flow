# Supabase project URL (Project Settings -> API)
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# service_role / secret key - SERVER ONLY. Never prefix with NEXT_PUBLIC_ and never commit it.
SUPABASE_SERVICE_ROLE_KEY=
# Random secret (>= 32 chars) mixed into password/MPIN hashes. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Changing it invalidates every stored password and MPIN.
AUTH_PEPPER=
